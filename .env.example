# Modelo das variáveis do DataBuild. Copie para `.env.local` (ignorado pelo Git) ou rode
# `python scripts/dbadmin.py init-env`, que gera as senhas. Valores reais ficam só no `.env.local`
# e no Bitwarden do dono; este arquivo documenta os nomes e nunca contém segredos.

# Servidor: host, host,porta ou host\instância (SQL Server 2022 Express local, porta fixa 1433).
DATABUILD_DB_SERVER=localhost,1433
DATABUILD_DB_NAME=databuild
DATABUILD_DB_DRIVER=ODBC Driver 18 for SQL Server
DATABUILD_DB_ENCRYPT=yes
DATABUILD_DB_TRUST_SERVER_CERT=yes

# Administração (DDL, migrations): windows (padrão, sem senha) ou sql.
DATABUILD_DB_ADMIN_AUTH=windows
# Só se DATABUILD_DB_ADMIN_AUTH=sql:
# DATABUILD_DB_ADMIN_USER=
# DATABUILD_DB_ADMIN_PASSWORD=

# Processamento do pipeline: lê e grava bronze, silver e gold.
DATABUILD_PIPELINE_USER=databuild_pipeline
DATABUILD_PIPELINE_PASSWORD=

# Power BI: somente leitura da camada gold.
DATABUILD_POWERBI_USER=databuild_powerbi
DATABUILD_POWERBI_PASSWORD=
