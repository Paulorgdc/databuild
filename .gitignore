# Dados e documentos confidenciais: nunca versionar (repositório público; sem exceções)
/data/
# Power BI: versionar somente os autores do projeto, nunca saídas do Desktop.
/dashboard/*
!/dashboard/.gitkeep
!/dashboard/build.py
!/dashboard/model.py
!/dashboard/report.py
!/dashboard/reconcile.py
!/dashboard/query-desktop.ps1
.pbi/
*.abf
*.pbip
*.pbir
*.pbism
*.tmdl
*.pbix
*.pbit
# anexos de extensão, fotos de campo e referências com dados pessoais
reference/
*.xlsx
*.xlsm
*.xls
*.xlsb
*.csv
~$*

# Saídas derivadas dos dados reais (valores, itens e células da empresa)
outputs/
*.log
*.bak
*.trn
*.dump
*.backup

# Ambiente local
.env
.env.local
.env.*
!/.env.example
.runtime/
airflow.cfg
airflow.db*
simple_auth_manager_passwords.json*
/airflow/logs/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
