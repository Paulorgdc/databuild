# Dados e documentos confidenciais: nunca versionar (repositório público; sem exceções)
/data/
# dashboard/ recebe o futuro Power BI; só a pasta é versionada
dashboard/*
!dashboard/.gitkeep
# anexos de extensão, fotos de campo e referências com dados pessoais
reference/
*.xlsx
*.xlsm
*.xls
*.xlsb
*.csv
*.pbix
*.pbit
~$*

# Saídas derivadas dos dados reais (valores, itens e células da empresa)
outputs/
*.log
*.bak
*.trn
*.dump
*.backup

# Ambiente local
.env
.env.*
!/.env.example
.runtime/
airflow.cfg
airflow.db*
simple_auth_manager_passwords.json*
/airflow/logs/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
